local function mod(path)
	local node = RS
	for seg in string.gmatch(path, "[^%.]+") do
		node = node and node:FindFirstChild(seg)
	end
	if not node then
		warn("[ADF] missing module " .. path)
		return nil
	end
	local ok, m = pcall(require, node)
	if not ok then
		warn("[ADF] require failed " .. path .. ": " .. tostring(m))
		return nil
	end
	return m
end

