local function rem(service, class, name)
	local svc = Net:FindFirstChild(service)
	local cls = svc and svc:FindFirstChild(class)
	local r = cls and cls:FindFirstChild(name)
	if not r then
		warn("[ADF] missing remote: " .. service .. "." .. class .. "." .. name)
	end
	return r
end

