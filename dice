local function pv(fn, ...)
	local ok, v = pcall(fn, ...)
	if ok then return v end
	return nil
end

local function log(msg)
	table.insert(Stats.log, 1, os.date("[%H:%M:%S] ") .. msg)
	while #Stats.log > 14 do
		table.remove(Stats.log)
	end
end

local function money()
